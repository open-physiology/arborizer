# Copy to .env and fill in real values (.env is git-ignored).
# On Render, set these as Environment Variables of the web service instead.

# MySQL database connection
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306

# Password that unlocks editing in the web UI
EDITOR_PASSWORD=

# Flask session signing key, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
